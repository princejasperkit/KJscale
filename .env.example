# Environment variables example for server

# SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="KJscale Careers <jobs@kjscale.online>"

# Destination for received applications
EMAIL_TO=careers@kjscale.online

# Server port
PORT=3000
